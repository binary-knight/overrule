  "keywords": [
    "ai",
    "llm",
    "multi-agent",
    "code-review",
    "security-review",
    "claude-code",
    "codex",
    "sandbox",
    "deliberation"
  ],
  "homepage": "https://github.com/binary-knight/overrule",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/binary-knight/overrule.git"
  },
  "bugs": {
    "url": "https://github.com/binary-knight/overrule/issues"
  },
  "author": "binary-knight",
  "license": "Apache-2.0",
  "bin": {
    "overrule": "bin/overrule.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.mjs",
    "restart": "bash restart.sh",
    "test": "node --test test/*.test.mjs",
    "test:restart": "python3 test/restart_test.py",
